#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct SortEntry {
    float depthKey;
    uint  payloadIndex;
};

layout(std140, binding = 0) uniform BitonicSortParams {
    // x = elementCount (power of two)
    // y = stageK (subsequence length: 2, 4, 8, ..., elementCount)
    // z = passJ  (compare stride: stageK/2, stageK/4, ..., 1)
    // w = ascending (1 = ascending, 0 = descending)
    uvec4 params;
} uSort;

layout(std430, binding = 0) buffer SortBuffer {
    SortEntry entries[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint elementCount = uSort.params.x;
    if (i >= elementCount) {
        return;
    }

    uint stageK    = uSort.params.y;
    uint passJ     = uSort.params.z;
    bool ascending = (uSort.params.w != 0u);

    uint partner = i ^ passJ;

    // Only the lower index of each disjoint pair performs the compare-and-swap.
    if (partner <= i || partner >= elementCount) {
        return;
    }

    bool blockAscending = ((i & stageK) == 0u);
    bool sortAscending  = ascending ? blockAscending : !blockAscending;

    SortEntry a = entries[i];
    SortEntry b = entries[partner];

    // Deterministic tie-breaking on payloadIndex when depth keys match.
    bool outOfOrder = sortAscending
        ? ((a.depthKey > b.depthKey) || (a.depthKey == b.depthKey && a.payloadIndex > b.payloadIndex))
        : ((a.depthKey < b.depthKey) || (a.depthKey == b.depthKey && a.payloadIndex < b.payloadIndex));

    if (outOfOrder) {
        entries[i]       = b;
        entries[partner] = a;
    }
}
